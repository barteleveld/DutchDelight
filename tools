def create_satisfaction_pdf():
    path = BIJLAGEN / "Bijlage 2 Klanttevredenheidsonderzoek TrueCacao.pdf"
    doc = SimpleDocTemplate(str(path), pagesize=A4, rightMargin=18 * mm, leftMargin=18 * mm, topMargin=16 * mm, bottomMargin=16 * mm)
    styles = getSampleStyleSheet()
    title = ParagraphStyle("Title", parent=styles["Title"], fontName="Helvetica-Bold", fontSize=17, textColor=colors.HexColor("#4b2358"), spaceAfter=10)
    h2 = ParagraphStyle("H2", parent=styles["Heading2"], fontName="Helvetica-Bold", fontSize=11, textColor=colors.HexColor("#4b2358"), spaceBefore=10, spaceAfter=4)
    body = ParagraphStyle("Body", parent=styles["BodyText"], fontName="Helvetica", fontSize=9, leading=12)

    story = [
        Paragraph("Bijlage 2 Klanttevredenheidsonderzoek TrueCacao", title),
        Paragraph("Onderzoek onder 24 zakelijke klanten die in mei of juni 2026 TrueCacao-producten hebben besteld.", body),
        Spacer(1, 6),
        Paragraph("Resultaten per onderwerp", h2),
    ]

    data = [
        ["Onderwerp", "Score", "Belangrijkste signaal"],
        ["Productkwaliteit", "4,4 / 5", "Klanten waarderen smaak en natuurlijke uitstraling."],
        ["Assortiment", "3,7 / 5", "Vraag naar meer proefpakketten en kleinere displays."],
        ["Levering", "3,2 / 5", "Enkele klanten noemen onduidelijke leverupdates."],
        ["Communicatie", "3,4 / 5", "Reacties zijn vriendelijk, maar opvolging mag concreter."],
        ["Service", "4,0 / 5", "Oplossingen worden gewaardeerd als de klant snel contact krijgt."],
    ]
    table = Table(data, colWidths=[42 * mm, 26 * mm, 96 * mm])
    table.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#d9ece6")),
        ("TEXTCOLOR", (0, 0), (-1, 0), colors.HexColor("#4b2358")),
        ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold"),
        ("GRID", (0, 0), (-1, -1), 0.4, colors.HexColor("#999999")),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ("FONTSIZE", (0, 0), (-1, -1), 8),
    ]))
    story.extend([table, Spacer(1, 8), Paragraph("Open reacties van klanten", h2)])

    reactions = [
        "De producten passen goed bij onze duurzame uitstraling, maar wij willen vooraf duidelijker weten wanneer de levering komt.",
        "De tasting packs werken goed als introductieproduct. Een kleiner displaypakket zou voor ons aantrekkelijk zijn.",
        "De accountmanager denkt mee, maar de bevestiging van afspraken mag sneller na het gesprek.",
        "Wij kregen bij een nalevering pas laat bericht. De oplossing was netjes, maar de communicatie kan eerder.",
        "De productinformatie is duidelijk. Voor allergenen en ingredienten willen wij graag een compacte kaart voor medewerkers.",
    ]
    for reaction in reactions:
        story.append(Paragraph(f"- {reaction}", body))

    story.extend([
        Spacer(1, 8),
        Paragraph("Interne aandachtspunten", h2),
        Paragraph("1. Maak leverupdates concreter: datum, status, mogelijke vertraging en contactpersoon.", body),
        Paragraph("2. Ontwikkel een compacte introductieset voor kleinere klanten.", body),
        Paragraph("3. Stuur na klantgesprekken binnen een werkdag een korte samenvatting met afspraken.", body),
    ])
    doc.build(story)


