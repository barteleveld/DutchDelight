<!doctype html><html lang="nl"><head><meta charset="utf-8"><title>Format notitie</title><style>body{font-family:Arial,sans-serif;font-size:11pt;line-height:1.45;color:#140f18}h1{color:#4b2358;font-size:18pt}h2{color:#4b2358;font-size:13pt;margin-top:20px}table{border-collapse:collapse;width:100%;margin-bottom:20px}th,td{border:1px solid #999;padding:8px;text-align:left;height:24px}.line{border-bottom:1px solid #999;height:24px;margin:6px 0 10px}</style></head><body><h1>Format notitie</h1><table><tr><th>Aan</th><td></td></tr><tr><th>Van</th><td></td></tr><tr><th>Datum</th><td></td></tr><tr><th>Onderwerp</th><td></td></tr></table><h2>Aanleiding</h2><div class="line"></div><div class="line"></div><div class="line"></div><h2>Uitwerking</h2><div class="line"></div><div class="line"></div><div class="line"></div><div class="line"></div><h2>Conclusie of advies</h2><div class="line"></div><div class="line"></div><div class="line"></div></body></html>